-- allium: 3
-- The host-loop plugin, realigned onto opencode's native /goal (plan/0109).
-- Three separations, restated for the realignment: the native coordinator is
-- the only controller (this plugin registers no idle hook and sends no
-- continuations); the tracked surfaces are the only state authority (the
-- verbs write receipts, the Status line, GOAL.md; the plugin writes nothing of
-- the sort); the host verifier stack is the sole verifier (the native
-- reviewer decides only whether another turn fires, and a wrong done writes
-- nothing here).
-- Scope: the bridge (verbs to native lifecycle) and the four belts. Excludes:
-- the verbs' internals (spec'd beside host-lifecycle), the native coordinator
-- itself (upstream's), and the tools' prompt contract (the A/B record).

enum ToolKind {
    -- The model-facing tool registry; there is no complete and never will be.
    show
    status
    record
    complete
}

entity GoalSurface {
    -- The host's tracked goal state, read through the verbs (v0.63.0: the
    -- composed gates close the work; the operator's acceptance closes the
    -- goal).
    state: active | parked | complete_pending | absent
    transitions state {
        absent -> active
        active -> parked
        parked -> active
        active -> complete_pending
        complete_pending -> absent
        terminal: absent
    }
}

entity NativeGoal {
    -- The native /goal object, driven through the same command surface the
    -- TUI widget uses. Its status is a driver detail, never the record.
    status: active | paused | cleared
    transitions status {
        active -> paused
        paused -> active
        active -> cleared
        terminal: cleared
    }
}

entity Tool {
    kind: ToolKind
    provided: Boolean
}

given {
    host: GoalSurface
    native: NativeGoal
}

surface HostLoop {
    facing host: GoalSurface
    provides:
        HostGoalSet(host)
        HostGoalParked(host)
        HostGoalUnparked(host)
        HostGoalCompleted(host)
        HostGoalAccepted(host)
        BeltFires(host)
    @guarantee UpstreamIsTheOnlyController
        -- The plugin registers no idle hook and sends no continuations; the
        -- native coordinator alone decides when a turn fires.
    @guarantee TrackedSurfacesAreTheAuthority
        -- Every state change lands through the verbs; the native object is
        -- driven to match, never read as the record.
    @guarantee WrongDoneWritesNothing
        -- A native reviewer done is a recoverable stop; it writes nothing to
        -- the receipts, the Status line, or GOAL.md.
    @guarantee BeltsAreMechanical
        -- The cap, the deadline, the NEEDS YOU stop, and the overwrite guard
        -- are counted, never judged; each pause prints its reason.
    @guarantee NoPersistentState
        -- The plugin writes no persistent state; only the armed session's goal
        -- id and arming time, in memory.
    @guarantee HonestTelemetry
        -- What the plugin reports is what the verbs and the goal rpc said.
}

-- === The bridge ===

rule SetArmsBoth {
    when: HostGoalSet(host)
    requires: host.state = absent
    ensures: host.state = active
    ensures: native.status = active
}

rule ParkPausesBoth {
    when: HostGoalParked(host)
    requires: host.state = active
    ensures: host.state = parked
    ensures: native.status = paused
}

rule UnparkResumesBoth {
    when: HostGoalUnparked(host)
    requires: host.state = parked and native.status = paused
    ensures: host.state = active
    ensures: native.status = active
}

rule CompleteClearsNative {
    when: HostGoalCompleted(host)
    requires: host.state = active
    ensures: host.state = complete_pending
    ensures: native.status = cleared
}

rule AcceptClosesHost {
    when: HostGoalAccepted(host)
    requires: host.state = complete_pending
    ensures: host.state = absent
}

-- === The belts ===

-- One pause outcome for all four mechanical reasons: the round cap, the
-- wall-clock deadline, the NEEDS YOU stop, and the native-overwrite guard.
-- Each fires only on an active native goal.
rule BeltPausesNative {
    when: BeltFires(host)
    requires: native.status = active
    ensures: native.status = paused
}

invariant NoCompletionTool {
    for t in Tools where t.kind = complete:
        not t.provided
}
